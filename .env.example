# ShopPulse Environment Configuration Template
# Copy this file to .env and configure with your local or cloud PostgreSQL credentials

# Database Engine: 'postgresql' or 'sqlite'
DB_ENGINE=sqlite

# PostgreSQL Connection Settings (when DB_ENGINE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shoppulse_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# SQLite Path (used when DB_ENGINE=sqlite or fallback)
SQLITE_DB_PATH=database/shoppulse.db

# App Settings
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
